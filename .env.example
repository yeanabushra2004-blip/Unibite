PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DATABASE=unibite
# Set a unique random value of at least 32 characters in .env.local before starting the backend.
JWT_SECRET=
# Store owner admin credentials in the git-ignored .env.local file.
ADMIN_NAME=UniBite Owner
ADMIN_EMAIL=
ADMIN_PASSWORD=
